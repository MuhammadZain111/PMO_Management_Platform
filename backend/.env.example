# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://pmo_app:pmo_dev_password@localhost:5432/pmo_dashboard"

# JWT signing secrets — use long random strings in production (e.g. `openssl rand -hex 64`)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# Token lifetimes
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="7"

# First PMO administrator, created by the seed script
PMO_ADMIN_EMAIL="pmo@example.com"
PMO_ADMIN_PASSWORD="ChangeMe123!"
PMO_ADMIN_NAME="PMO Administrator"

# CORS — the frontend origin allowed to call this API with credentials
FRONTEND_URL="http://localhost:5173"

PORT=4000
NODE_ENV="development"
